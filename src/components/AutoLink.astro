---
/**
 * AutoLink — transforme les [[titre]] en liens cliquables et
 * détecte aussi les mentions de titres sans crochets.
 */
import { getCollection } from 'astro:content';

interface Props {
  currentTitle: string;
  selector?: string;
}

const { currentTitle, selector = '.fiche-content' } = Astro.props;

const animes = await getCollection('animes');
const films = await getCollection('films');

const titleIndex = [
  ...animes.map(a => ({ titre: String(a.data.titre), href: `/animes/${a.id}` })),
  ...films.map(f => ({ titre: String(f.data.titre), href: `/films/${f.id}` })),
]
  .filter(item => item.titre.toLowerCase() !== currentTitle.toLowerCase())
  .filter(item => item.titre.length >= 3)
  .sort((a, b) => b.titre.length - a.titre.length);
---

<script define:vars={{ titleIndex, selector }}>
  document.addEventListener('DOMContentLoaded', () => {
    const container = document.querySelector(selector);
    if (!container) return;

    // Normalise un titre pour comparaison tolérante :
    // - apostrophes courbes → droites
    // - supprime :  ;  !  et espaces multiples
    // - minuscules
    function normalizeKey(s) {
      return s
        .replace(/[\u2018\u2019\u02BC]/g, "'")  // apostrophes courbes → droites
        .replace(/&#\d+;/g, '')                  // entités HTML numériques
        .replace(/&amp;/g, '&')                  // &amp; → &
        .replace(/[!:;]/g, '')                   // ponctuation problématique
        .toLowerCase()
        .replace(/\s+/g, ' ')
        .trim();
    }

    // Normalise uniquement les apostrophes (pour l'étape 2)
    function normalizeApos(s) {
      return s.replace(/[\u2018\u2019\u02BC]/g, "'");
    }

    // Map normalisée pour recherche rapide
    const titleMap = new Map();
    titleIndex.forEach(item => {
      titleMap.set(normalizeKey(item.titre), item);
    });

    // Fonction de recherche tolérante
    function findTitle(text) {
      return titleMap.get(normalizeKey(text)) || null;
    }

    const alreadyLinked = new Set();

    // Étape 1 : Remplacer tous les [[titre]] par des liens (partout, y compris headings)
    let html = container.innerHTML;

    function escHtml(s) { return s.replace(/&/g,'&amp;').replace(/"/g,'&quot;').replace(/'/g,'&#39;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }

    html = html.replace(/\[\[([^\]|]+)(?:\|([^\]]+))?\]\]/g, (match, ref, display) => {
      const item = findTitle(ref);
      const shown = (display || ref).trim();
      if (item) {
        alreadyLinked.add(normalizeKey(item.titre));
        return '<a href="' + item.href + '" title="Voir la fiche : ' + escHtml(item.titre) + '">' + escHtml(shown) + '</a>';
      }
      // Pas de fiche → retirer juste les crochets
      return shown;
    });

    // Étape 1b : Récupérer les [[titre!]] cassés par le parser Markdown
    // Markdown peut transformer "[[Titre!]]" en "[[Titre!" + image syntax
    // On cherche les [[ orphelins restants
    html = html.replace(/\[\[([^\]<]+?)!?\s*(?:\]\]|$)/g, (match, innerText) => {
      if (match.includes('<a ')) return match; // déjà un lien
      const item = findTitle(innerText) || findTitle(innerText + '!');
      if (item) {
        alreadyLinked.add(normalizeKey(item.titre));
        return '<a href="' + item.href + '" title="Voir la fiche : ' + escHtml(item.titre) + '">' + escHtml(innerText.trim()) + '</a>';
      }
      return match;
    });

    container.innerHTML = html;

    // Étape 2 : Parcourir les nœuds texte pour linker les titres sans [[]]
    function walkTextNodes(node) {
      if (node.nodeType === Node.TEXT_NODE) return [node];
      const tag = node.tagName;
      if (tag === 'A' || tag === 'CODE' || tag === 'PRE') return [];
      const nodes = [];
      node.childNodes.forEach(child => nodes.push(...walkTextNodes(child)));
      return nodes;
    }

    // Titres trop génériques → linkés uniquement avec [[crochets]]
    // (utiliser normalizeKey pour les clés)
    const noAutoLink = new Set([
      'les autres',
      'another',
      'monster',
      'nana',
      'k',
      'ma',
      '86',
      'ca',
    ]);

    const textNodes = walkTextNodes(container);
    const wordBoundary = /[\s.,;:!?()«»""'\-—\/\[\]]/;

    for (const textNode of textNodes) {
      const text = textNode.textContent;
      if (!text || text.trim().length < 3) continue;

      for (const item of titleIndex) {
        if (alreadyLinked.has(normalizeKey(item.titre))) continue;
        if (noAutoLink.has(normalizeKey(item.titre))) continue;

        const idx = normalizeApos(text).toLowerCase().indexOf(normalizeApos(item.titre).toLowerCase());
        if (idx === -1) continue;

        // Vérifier les limites de mots
        if (idx > 0 && !wordBoundary.test(text[idx - 1])) continue;
        const endIdx = idx + item.titre.length;
        if (endIdx < text.length && !wordBoundary.test(text[endIdx])) continue;

        const fragment = document.createDocumentFragment();
        if (idx > 0) {
          fragment.appendChild(document.createTextNode(text.substring(0, idx)));
        }
        const link = document.createElement('a');
        link.href = item.href;
        link.textContent = text.substring(idx, endIdx);
        link.title = 'Voir la fiche : ' + item.titre;
        fragment.appendChild(link);
        if (endIdx < text.length) {
          fragment.appendChild(document.createTextNode(text.substring(endIdx)));
        }

        textNode.parentNode.replaceChild(fragment, textNode);
        alreadyLinked.add(normalizeKey(item.titre));
        break;
      }
    }
  });
</script>
