---
import Base from '../../layouts/Base.astro';
import Card from '../../components/Card.astro';
import { getCollection } from 'astro:content';
import fs from 'node:fs';
import path from 'node:path';

// Tri par défaut : dernière modification du fichier
const contentDir = path.resolve('src/content/animes');
const allAnimes = (await getCollection('animes'))
  .map(a => {
    const filePath = path.join(contentDir, `${a.id}.md`);
    let mtime = a.data.date_ajout?.getTime() || 0;
    try { mtime = fs.statSync(filePath).mtimeMs; } catch {}
    return { ...a, mtime };
  })
  .sort((a, b) => b.mtime - a.mtime);

const animes = allAnimes.filter(a => String(a.data.note) !== '?/20');
const ragequits = allAnimes.filter(a => a.data.raquequit === 'oui');

const allGenres = [...new Set(animes.flatMap(a => a.data.genres))].sort();
const allRecos = [...new Set(animes.map(a => a.data.recommandation).filter(Boolean))].sort();
const allStudios = [...new Set(animes.flatMap(a => a.data.studios || []))].sort();
const allRealisateurs = [...new Set(animes.map(a => a.data.realisateur).filter(Boolean) as string[])].sort();

function parseNote(note: string): number {
  const match = note?.match(/^(\d+(?:[.,]\d+)?)/);
  return match ? parseFloat(match[1].replace(',', '.')) : 0;
}
---

<Base title="Catalogue Animés" description="Toutes les fiches animés de Cinemationis">
  <div class="container">
    <h1 class="section-title">Animés <span class="count" id="count">({animes.length})</span></h1>

    <div class="filters-bar">
      <input type="text" id="search" placeholder="Rechercher un animé..." class="filter-input" />
      <div class="filter-row">
        <select id="reco-filter" class="filter-select">
          <option value="">Toutes les recos</option>
          {allRecos.map(r => <option value={r}>{r}</option>)}
        </select>
        <select id="studio-filter" class="filter-select">
          <option value="">Tous les studios</option>
          {allStudios.map(s => <option value={s}>{s}</option>)}
        </select>
        <select id="realisateur-filter" class="filter-select">
          <option value="">Tous les réalisateurs</option>
          {allRealisateurs.map(r => <option value={r}>{r}</option>)}
        </select>
        <select id="sort" class="filter-select">
          <option value="mtime-desc">Dernière modification</option>
          <option value="date-desc">Date d'ajout</option>
          <option value="titre">Titre A-Z</option>
          <option value="note-desc">Meilleure note</option>
          <option value="note-asc">Moins bonne note</option>
          <option value="annee-desc">Plus récent</option>
          <option value="annee-asc">Plus ancien</option>
        </select>
      </div>
    </div>

    <div class="genre-section">
      <div class="genre-label">Genres :</div>
      <div class="genre-tags" id="genre-tags">
        {allGenres.map(g => (
          <button class="genre-tag" data-genre={g} data-state="off">{g}</button>
        ))}
      </div>
      <div class="genre-legend">
        <span class="legend-item"><span class="dot dot--include"></span> Inclus</span>
        <span class="legend-item"><span class="dot dot--exclude"></span> Exclus</span>
        <span class="legend-hint">Clic = inclure, 2e clic = exclure, 3e = retirer</span>
      </div>
    </div>

    <div class="cards-grid" id="cards">
      {animes.map((anime) => (
        <Card
          titre={anime.data.titre}
          image={anime.data.image}
          note={anime.data.note}
          annee={anime.data.annee}
          href={`/animes/${anime.id}`}
          genres={anime.data.genres}
          recommandation={anime.data.recommandation}
          noteNum={parseNote(anime.data.note)}
          dateAjout={anime.data.date_ajout?.toISOString() || ''}
          mtime={new Date(anime.mtime).toISOString()}
          studios={anime.data.studios}
          realisateur={anime.data.realisateur || ''}
        />
      ))}
    </div>

    <div class="pagination" id="pagination"></div>

    {ragequits.length > 0 && (
      <section class="ragequit-section">
        <h2 class="ragequit-title">Petits êtres ragequit trop tôt</h2>
        <p class="ragequit-desc">Ces animés ont été abandonnés en cours de route. Pas de note, pas de commentaire — juste un ragequit.</p>
        <div class="ragequit-grid">
          {ragequits.map(a => (
            <a href={`/animes/${a.id}`} class="ragequit-item">
              {a.data.image ? (
                <img src={a.data.image} alt={a.data.titre} loading="lazy" />
              ) : (
                <div class="ragequit-placeholder"></div>
              )}
              <span class="ragequit-label">{a.data.titre}</span>
            </a>
          ))}
        </div>
      </section>
    )}
  </div>
</Base>

<style>
  .count { color: var(--text-muted); font-weight: 400; font-size: 1rem; }

  .filters-bar { margin: 1.5rem 0 1rem; display: flex; flex-direction: column; gap: 0.75rem; }
  .filter-input {
    width: 100%;
    background: var(--bg-card);
    color: var(--text);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 0.6rem 1rem;
    font-size: 0.95rem;
  }
  .filter-input:focus { outline: none; border-color: var(--accent-2); }
  .filter-row { display: flex; gap: 0.75rem; flex-wrap: wrap; }
  .filter-select {
    background: var(--bg-card);
    color: var(--text);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 0.5rem 0.75rem;
    font-size: 0.85rem;
    cursor: pointer;
  }
  .filter-select:focus { outline: none; border-color: var(--accent-2); }

  .genre-section { margin-bottom: 1.5rem; }
  .genre-label { font-size: 0.9rem; color: var(--text-muted); margin-bottom: 0.5rem; }
  .genre-tags { display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .genre-tag {
    background: var(--bg-card);
    color: var(--text-muted);
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0.25rem 0.7rem;
    font-size: 0.8rem;
    cursor: pointer;
    transition: all 0.15s;
    font-family: inherit;
  }
  .genre-tag:hover { border-color: var(--text-muted); }
  .genre-tag[data-state="include"] {
    background: var(--accent-2);
    color: white;
    border-color: var(--accent-2);
  }
  .genre-tag[data-state="exclude"] {
    background: var(--accent);
    color: white;
    border-color: var(--accent);
    text-decoration: line-through;
  }
  .genre-legend { display: flex; gap: 1rem; align-items: center; margin-top: 0.5rem; flex-wrap: wrap; }
  .legend-item { display: flex; align-items: center; gap: 0.3rem; font-size: 0.75rem; color: var(--text-muted); }
  .dot { width: 8px; height: 8px; border-radius: 50%; display: inline-block; }
  .dot--include { background: var(--accent-2); }
  .dot--exclude { background: var(--accent); }
  .genre-legend .legend-hint { font-size: 0.7rem; color: var(--text-muted); opacity: 0.7; }

  /* pagination dans global.css */

  .ragequit-section {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border);
  }
  .ragequit-title {
    font-size: 1.3rem;
    color: var(--accent);
    margin-bottom: 0.4rem;
  }
  .ragequit-desc {
    font-size: 0.85rem;
    color: var(--text-muted);
    margin-bottom: 1.2rem;
  }
  .ragequit-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }
  .ragequit-item {
    width: 100px;
    text-decoration: none;
    color: var(--text);
    transition: transform 0.2s;
    opacity: 0.7;
  }
  .ragequit-item:hover { transform: translateY(-3px); opacity: 1; text-decoration: none; }
  .ragequit-item img {
    width: 100px;
    height: 140px;
    object-fit: cover;
    border-radius: 4px;
    border: 1px solid var(--border);
    filter: grayscale(40%);
    transition: filter 0.2s;
  }
  .ragequit-item:hover img { filter: grayscale(0%); }
  .ragequit-placeholder {
    width: 100px;
    height: 140px;
    background: var(--bg-hover);
    border-radius: 4px;
    border: 1px solid var(--border);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.5rem;
    color: var(--text-muted);
  }
  .ragequit-placeholder::after { content: "?"; }
  .ragequit-label {
    display: block;
    font-size: 0.75rem;
    color: var(--text-muted);
    margin-top: 0.3rem;
    line-height: 1.2;
    text-align: center;
  }
</style>

<script>
  const PER_PAGE = 20;
  let currentPage = 1;

  const search = document.getElementById('search') as HTMLInputElement;
  const recoFilter = document.getElementById('reco-filter') as HTMLSelectElement;
  const studioFilter = document.getElementById('studio-filter') as HTMLSelectElement;
  const realFilter = document.getElementById('realisateur-filter') as HTMLSelectElement;
  const sortSelect = document.getElementById('sort') as HTMLSelectElement;
  const grid = document.getElementById('cards')!;
  const countEl = document.getElementById('count')!;
  const paginationEl = document.getElementById('pagination')!;
  const cards = Array.from(grid.children) as HTMLElement[];
  const genreTags = document.querySelectorAll('.genre-tag') as NodeListOf<HTMLButtonElement>;

  genreTags.forEach(tag => {
    tag.addEventListener('click', () => {
      const state = tag.dataset.state;
      if (state === 'off') tag.dataset.state = 'include';
      else if (state === 'include') tag.dataset.state = 'exclude';
      else tag.dataset.state = 'off';
      currentPage = 1;
      filterAndSort();
    });
  });

  function getGenreFilters() {
    const include: string[] = [];
    const exclude: string[] = [];
    genreTags.forEach(tag => {
      if (tag.dataset.state === 'include') include.push(tag.dataset.genre!);
      if (tag.dataset.state === 'exclude') exclude.push(tag.dataset.genre!);
    });
    return { include, exclude };
  }

  function filterAndSort() {
    const query = search.value.toLowerCase();
    const reco = recoFilter.value;
    const studio = studioFilter.value;
    const real = realFilter.value;
    const { include: genresInclude, exclude: genresExclude } = getGenreFilters();

    // Filtre
    let visible = cards.filter(card => {
      const title = card.dataset.titre || '';
      const genres = (card.dataset.genres || '').split(',').filter(Boolean);
      const cardReco = card.dataset.reco || '';
      const cardStudios = card.dataset.studios || '';
      const cardReal = card.dataset.realisateur || '';

      return title.includes(query)
        && (!reco || cardReco === reco)
        && (!studio || cardStudios.split(',').includes(studio))
        && (!real || cardReal === real.toLowerCase())
        && (genresInclude.length === 0 || genresInclude.every(g => genres.includes(g)))
        && (genresExclude.length === 0 || !genresExclude.some(g => genres.includes(g)));
    });

    // Tri
    const sortVal = sortSelect.value;
    visible.sort((a, b) => {
      switch (sortVal) {
        case 'note-desc': return parseFloat(b.dataset.note || '0') - parseFloat(a.dataset.note || '0');
        case 'note-asc': return parseFloat(a.dataset.note || '0') - parseFloat(b.dataset.note || '0');
        case 'annee-desc': return parseInt(b.dataset.annee || '0') - parseInt(a.dataset.annee || '0');
        case 'annee-asc': return parseInt(a.dataset.annee || '0') - parseInt(b.dataset.annee || '0');
        case 'mtime-desc': return (b.dataset.mtime || '').localeCompare(a.dataset.mtime || '');
        case 'date-desc': return (b.dataset.date || '').localeCompare(a.dataset.date || '');
        case 'titre': return (a.dataset.titre || '').localeCompare(b.dataset.titre || '', 'fr');
        default: return 0;
      }
    });

    // Pagination
    const totalPages = Math.max(1, Math.ceil(visible.length / PER_PAGE));
    if (currentPage > totalPages) currentPage = totalPages;
    const start = (currentPage - 1) * PER_PAGE;
    const pageItems = visible.slice(start, start + PER_PAGE);

    // Affichage
    cards.forEach(c => c.style.display = 'none');
    pageItems.forEach(card => { card.style.display = ''; grid.appendChild(card); });
    cards.filter(c => c.style.display === 'none').forEach(c => grid.appendChild(c));

    countEl.textContent = `(${visible.length})`;
    renderPagination(totalPages);
  }

  function renderPagination(totalPages: number) {
    if (totalPages <= 1) { paginationEl.innerHTML = ''; return; }
    let html = `<button data-page="prev" ${currentPage === 1 ? 'disabled' : ''}>&laquo;</button>`;
    for (let i = 1; i <= totalPages; i++) {
      if (totalPages > 7 && i > 2 && i < totalPages - 1 && Math.abs(i - currentPage) > 1) {
        if (i === 3 || i === totalPages - 2) html += `<span class="pagination-dots">...</span>`;
        continue;
      }
      html += `<button data-page="${i}" class="${i === currentPage ? 'active' : ''}">${i}</button>`;
    }
    html += `<button data-page="next" ${currentPage === totalPages ? 'disabled' : ''}>&raquo;</button>`;
    paginationEl.innerHTML = html;

    paginationEl.querySelectorAll('button').forEach(btn => {
      btn.addEventListener('click', () => {
        const p = btn.dataset.page;
        if (p === 'prev') currentPage--;
        else if (p === 'next') currentPage++;
        else currentPage = parseInt(p!);
        filterAndSort();
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });
    });
  }

  search.addEventListener('input', () => { currentPage = 1; filterAndSort(); });
  recoFilter.addEventListener('change', () => { currentPage = 1; filterAndSort(); });
  realFilter.addEventListener('change', () => { currentPage = 1; filterAndSort(); });
  studioFilter.addEventListener('change', () => { currentPage = 1; filterAndSort(); });
  sortSelect.addEventListener('change', () => { currentPage = 1; filterAndSort(); });

  filterAndSort();
</script>
