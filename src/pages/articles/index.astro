---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const articles = (await getCollection('articles'))
  .sort((a, b) => {
    const da = a.data.date_publication ? new Date(a.data.date_publication).getTime() : 0;
    const db = b.data.date_publication ? new Date(b.data.date_publication).getTime() : 0;
    return db - da;
  });
---

<Base title="Articles" description="Articles et dossiers cinéma de Cinemationis">
  <div class="container">
    <h1 class="section-title">Articles <span class="count" id="count">({articles.length})</span></h1>

    <div class="sort-bar">
      <span class="sort-label">Trier par :</span>
      <button class="sort-btn active" data-sort="date" data-order="desc">Date ▼</button>
      <button class="sort-btn" data-sort="alpha" data-order="asc">A — Z ▲</button>
    </div>

    <div class="articles-list" id="articles">
      {articles.map((article) => (
        <a href={`/articles/${article.id}`} class="article-card"
           data-titre={article.data.titre}
           data-date={article.data.date_publication ? new Date(article.data.date_publication).toISOString() : ''}>
          {article.data.image && (
            <img src={article.data.image} alt={article.data.titre} class="article-thumb" loading="lazy" />
          )}
          <div class="article-info">
            <h2>{article.data.titre}</h2>
            {article.data.resume && <p>{article.data.resume}</p>}
          </div>
        </a>
      ))}
    </div>

    <div class="pagination" id="pagination"></div>
  </div>
</Base>

<style>
  .count { color: var(--text-muted); font-weight: 400; font-size: 1rem; }
  .sort-bar {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1rem;
  }
  .sort-label {
    color: var(--text-muted);
    font-size: 0.9rem;
    margin-right: 0.25rem;
  }
  .sort-btn {
    background: var(--bg-card);
    border: 1px solid var(--border);
    color: var(--text-muted);
    padding: 0.35rem 0.9rem;
    border-radius: var(--radius);
    cursor: pointer;
    font-size: 0.85rem;
    transition: all 0.2s;
  }
  .sort-btn:hover {
    border-color: var(--accent-2);
    color: var(--text);
  }
  .sort-btn.active {
    background: var(--accent-2);
    border-color: var(--accent-2);
    color: #fff;
  }
  .articles-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-top: 1.5rem;
  }
  .article-card {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1rem 1.25rem;
    transition: border-color 0.2s;
    color: var(--text);
    overflow: hidden;
  }
  .article-card:hover {
    border-color: var(--accent-2);
    text-decoration: none;
  }
  .article-thumb {
    width: 120px;
    height: 80px;
    object-fit: cover;
    border-radius: 6px;
    flex-shrink: 0;
  }
  .article-info { flex: 1; min-width: 0; }
  .article-card h2 { font-size: 1.15rem; margin-bottom: 0.4rem; }
  .article-card p { color: var(--text-muted); font-size: 0.9rem; }

  @media (max-width: 600px) {
    .article-card { flex-direction: column; align-items: stretch; }
    .article-thumb { width: 100%; height: 140px; }
  }

  /* pagination dans global.css */
</style>

<script>
  const PER_PAGE = 10;
  let currentPage = 1;
  let currentSort = 'date';
  let currentOrder = 'desc';

  const list = document.getElementById('articles')!;
  const paginationEl = document.getElementById('pagination')!;
  let items = Array.from(list.children) as HTMLElement[];

  // Boutons de tri
  const sortBtns = document.querySelectorAll('.sort-btn') as NodeListOf<HTMLElement>;
  sortBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      if (btn.dataset.sort === currentSort) {
        // Même bouton → inverser l'ordre
        currentOrder = currentOrder === 'asc' ? 'desc' : 'asc';
      } else {
        // Nouveau bouton → ordre par défaut
        currentSort = btn.dataset.sort || 'date';
        currentOrder = currentSort === 'date' ? 'desc' : 'asc';
      }
      btn.dataset.order = currentOrder;
      sortBtns.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');

      // Mettre à jour le texte du bouton
      sortBtns.forEach(b => {
        const arrow = b.dataset.order === 'desc' ? '▼' : '▲';
        if (b.dataset.sort === 'date') b.textContent = 'Date ' + arrow;
        else b.textContent = (b.dataset.order === 'asc' ? 'A — Z' : 'Z — A') + ' ' + arrow;
      });

      currentPage = 1;
      sortAndPaginate();
    });
  });

  function sortItems() {
    const dir = currentOrder === 'asc' ? 1 : -1;
    items.sort((a, b) => {
      if (currentSort === 'alpha') {
        const ta = a.dataset.titre || '';
        const tb = b.dataset.titre || '';
        return dir * ta.localeCompare(tb, 'fr');
      } else {
        const da = a.dataset.date || '';
        const db = b.dataset.date || '';
        return dir * da.localeCompare(db);
      }
    });
    items.forEach(item => list.appendChild(item));
  }

  function paginate() {
    const totalPages = Math.max(1, Math.ceil(items.length / PER_PAGE));
    if (currentPage > totalPages) currentPage = totalPages;
    const start = (currentPage - 1) * PER_PAGE;

    items.forEach((item, i) => {
      item.style.display = (i >= start && i < start + PER_PAGE) ? '' : 'none';
    });

    if (totalPages <= 1) { paginationEl.innerHTML = ''; return; }
    let html = `<button data-page="prev" ${currentPage === 1 ? 'disabled' : ''}>&laquo;</button>`;
    for (let i = 1; i <= totalPages; i++) {
      html += `<button data-page="${i}" class="${i === currentPage ? 'active' : ''}">${i}</button>`;
    }
    html += `<button data-page="next" ${currentPage === totalPages ? 'disabled' : ''}>&raquo;</button>`;
    paginationEl.innerHTML = html;

    paginationEl.querySelectorAll('button').forEach(btn => {
      btn.addEventListener('click', () => {
        const p = btn.dataset.page;
        if (p === 'prev') currentPage--;
        else if (p === 'next') currentPage++;
        else currentPage = parseInt(p!);
        sortAndPaginate();
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });
    });
  }

  function sortAndPaginate() {
    sortItems();
    paginate();
  }

  sortAndPaginate();
</script>
