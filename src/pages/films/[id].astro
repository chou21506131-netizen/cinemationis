---
import Base from '../../layouts/Base.astro';
import AutoLink from '../../components/AutoLink.astro';
import { getCollection, render } from 'astro:content';

const allFilms = await getCollection('films');

export async function getStaticPaths() {
  const films = await getCollection('films');
  return films.map(film => ({
    params: { id: film.id },
    props: { film },
  }));
}

const { film } = Astro.props;
const { Content } = await render(film);
const d = film.data;

const sameGenre = allFilms
  .filter(f => f.id !== film.id)
  .map(f => {
    const common = f.data.genres.filter(g => d.genres.includes(g));
    return { film: f, commonCount: common.length };
  })
  .filter(({ commonCount }) => commonCount === d.genres.length || commonCount >= 3)
  .sort((a, b) => b.commonCount - a.commonCount)
  .slice(0, 12)
  .map(x => x.film);

const sameDirector = d.realisateur
  ? allFilms
      .filter(f => f.id !== film.id && f.data.realisateur === d.realisateur)
      .slice(0, 12)
  : [];
---

<Base title={d.titre} description={d.resume_court || undefined}>
  <div class="fiche">
    <div class="fiche-header">
      {d.image && <img src={d.image} alt={d.titre} class="fiche-poster" />}
      <div class="fiche-info">
        <h1>{d.titre}</h1>
        <p class="meta-line"><strong>Note :</strong> {d.note} {d.score_alo ? `(IMDb : ${d.score_alo})` : ''}</p>
        <p class="meta-line"><strong>Année :</strong> {d.annee}</p>
        {d.realisateur && <p class="meta-line"><strong>Réalisateur :</strong> {d.realisateur}</p>}
        <p class="meta-line"><strong>Recommandation :</strong> {d.recommandation}</p>
        <div class="genres">
          {d.genres.map(g => <a href={`/films?genre=${g}`} class="tag">{g}</a>)}
        </div>
      </div>
    </div>

    <div class="fiche-content">
      <Content />
    </div>
    <AutoLink currentTitle={d.titre} />

    {d.bande_annonce && (
      <div class="trailer">
        <h2>Bande annonce</h2>
        <div class="video-wrapper">
          <iframe
            src={`https://www.youtube.com/embed/${d.bande_annonce.split('v=')[1]?.split('&')[0] || d.bande_annonce.split('/').pop()}`}
            title={`Bande annonce - ${d.titre}`}
            frameborder="0"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen
          ></iframe>
        </div>
      </div>
    )}

    {sameGenre.length > 0 && (
      <section class="reco-section">
        <h3 class="reco-title">Du même genre...</h3>
        <button class="reco-arrow reco-arrow--left" aria-label="Défiler à gauche">&#8249;</button>
        <div class="reco-track">
          <div class="reco-strip">
            {sameGenre.map(f => (
              <a href={`/films/${f.id}`} class="reco-item" title={f.data.titre}>
                {f.data.image ? (
                  <img src={f.data.image} alt={f.data.titre} loading="lazy" />
                ) : (
                  <div class="reco-placeholder"></div>
                )}
                <span class="reco-label">{f.data.titre}</span>
              </a>
            ))}
          </div>
        </div>
        <button class="reco-arrow reco-arrow--right" aria-label="Défiler à droite">&#8250;</button>
      </section>
    )}

    {sameDirector.length > 0 && (
      <section class="reco-section">
        <h3 class="reco-title">Du même réalisateur ({d.realisateur})</h3>
        <button class="reco-arrow reco-arrow--left" aria-label="Défiler à gauche">&#8249;</button>
        <div class="reco-track">
          <div class="reco-strip">
            {sameDirector.map(f => (
              <a href={`/films/${f.id}`} class="reco-item" title={f.data.titre}>
                {f.data.image ? (
                  <img src={f.data.image} alt={f.data.titre} loading="lazy" />
                ) : (
                  <div class="reco-placeholder"></div>
                )}
                <span class="reco-label">{f.data.titre}</span>
              </a>
            ))}
          </div>
        </div>
        <button class="reco-arrow reco-arrow--right" aria-label="Défiler à droite">&#8250;</button>
      </section>
    )}

    <div class="fiche-nav">
      <a href="/films">&larr; Retour au catalogue</a>
    </div>
  </div>
</Base>

<script>
  document.querySelectorAll('.reco-section').forEach(section => {
    const track = section.querySelector('.reco-track') as HTMLElement;
    const strip = section.querySelector('.reco-strip') as HTMLElement;
    const leftBtn = section.querySelector('.reco-arrow--left') as HTMLElement;
    const rightBtn = section.querySelector('.reco-arrow--right') as HTMLElement;
    if (!track || !strip) return;

    const items = Array.from(strip.children);
    if (items.length <= 3) {
      track.style.overflowX = 'auto';
      leftBtn?.remove();
      rightBtn?.remove();
      return;
    }

    // Dupliquer les items pour boucle infinie
    items.forEach(item => strip.appendChild(item.cloneNode(true)));
    const duration = items.length * 3;
    strip.style.setProperty('--scroll-duration', `${duration}s`);
    strip.classList.add('scrolling');

    // Flèches : passer en mode scroll manuel
    function enableManualScroll() {
      strip.classList.remove('scrolling');
      strip.style.animation = 'none';
      strip.style.transform = 'none';
      strip.style.width = '';
      while (strip.children.length > items.length) {
        strip.removeChild(strip.lastChild!);
      }
      track.style.overflowX = 'auto';
      section.classList.add('manual');
    }

    leftBtn?.addEventListener('click', () => {
      if (!section.classList.contains('manual')) enableManualScroll();
      track.scrollBy({ left: -200, behavior: 'smooth' });
    });
    rightBtn?.addEventListener('click', () => {
      if (!section.classList.contains('manual')) enableManualScroll();
      track.scrollBy({ left: 200, behavior: 'smooth' });
    });
  });
</script>

<style>
  .genres { display: flex; gap: 0.4rem; flex-wrap: wrap; margin-top: 0.75rem; }
  .genres .tag { cursor: pointer; transition: border-color 0.15s; }
  .genres .tag:hover { border-color: var(--accent-2); text-decoration: none; }
  .fiche-nav { margin-top: 2rem; padding-top: 1rem; border-top: 1px solid var(--border); }
  .fiche-nav a { color: var(--text-muted); font-size: 0.9rem; }
  .trailer { margin-top: 2rem; }
  .trailer h2 { font-size: 1.3rem; margin-bottom: 0.75rem; border-bottom: 1px solid var(--border); padding-bottom: 0.3rem; }
  .video-wrapper { position: relative; padding-bottom: 56.25%; height: 0; }
  .video-wrapper iframe { position: absolute; top: 0; left: 0; width: 100%; height: 100%; border-radius: var(--radius); }

  .reco-section { margin-top: 2rem; overflow: hidden; position: relative; }
  .reco-title {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--text-muted);
    margin-bottom: 0.6rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .reco-track {
    overflow: hidden;
  }
  .reco-track::-webkit-scrollbar { height: 4px; }
  .reco-track::-webkit-scrollbar-track { background: transparent; }
  .reco-track::-webkit-scrollbar-thumb { background: var(--border); border-radius: 2px; }

  .reco-arrow {
    position: absolute;
    top: calc(50% + 0.4rem);
    transform: translateY(-50%);
    width: 32px;
    height: 32px;
    border-radius: 50%;
    border: 1px solid var(--border);
    background: var(--bg-card);
    color: var(--text);
    font-size: 1.3rem;
    line-height: 1;
    cursor: pointer;
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity 0.2s, background 0.15s, border-color 0.15s;
  }
  .reco-section:hover .reco-arrow { opacity: 1; }
  .reco-arrow:hover { background: var(--bg-hover); border-color: var(--accent-2); }
  .reco-arrow--left { left: 4px; }
  .reco-arrow--right { right: 4px; }

  .reco-strip {
    display: flex;
    width: max-content;
    gap: 0.6rem;
    padding-bottom: 0.5rem;
  }
  .reco-strip.scrolling {
    animation: scroll-strip var(--scroll-duration, 25s) linear infinite;
  }
  .reco-strip.scrolling:hover {
    animation-play-state: paused;
  }

  @keyframes scroll-strip {
    0% { transform: translateX(0); }
    100% { transform: translateX(calc(-50% - 0.3rem)); }
  }

  .reco-item {
    flex-shrink: 0;
    width: 90px;
    text-decoration: none;
    color: var(--text);
    transition: transform 0.2s;
  }
  .reco-item:hover { transform: translateY(-3px); text-decoration: none; }
  .reco-item img {
    width: 90px;
    height: 125px;
    object-fit: cover;
    border-radius: 4px;
    border: 1px solid var(--border);
    transition: border-color 0.2s;
  }
  .reco-item:hover img { border-color: var(--accent-2); }
  .reco-placeholder {
    width: 90px;
    height: 125px;
    background: var(--bg-hover);
    border-radius: 4px;
    border: 1px solid var(--border);
  }
  .reco-label {
    display: block;
    font-size: 0.7rem;
    color: var(--text-muted);
    margin-top: 0.25rem;
    line-height: 1.2;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* Mobile : désactiver le scroll infini, permettre le swipe */
  @media (max-width: 768px) {
    .reco-track { overflow-x: auto; -webkit-overflow-scrolling: touch; }
    .reco-strip { width: max-content; }
    .reco-strip.scrolling { animation: none; }
    .reco-arrow { display: none; }
    .reco-item { width: 80px; }
    .reco-item img, .reco-placeholder { width: 80px; height: 112px; }
    .reco-label { font-size: 0.75rem; }
  }
</style>
