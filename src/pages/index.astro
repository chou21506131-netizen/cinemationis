---
// Pas de layout Base — la page d'accueil a son propre design plein écran
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Cinemationis — Revues animés, films d'horreur et articles cinéma" />
    <title>Cinemationis</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <div class="home">
      <!-- Logo flottant -->
      <div class="home-logo">Cinemat<span>ion</span>is</div>

      <div class="panels">
        <!-- ANIME (gauche) -->
        <a href="/animes" class="panel panel--anime">
          <div class="panel-bg"></div>
          <div class="panel-overlay"></div>
          <div class="panel-content">
            <h2>Animés</h2>
            <span class="panel-cta">Explorer &rarr;</span>
          </div>
          <div class="particle p1"></div>
          <div class="particle p2"></div>
          <div class="particle p3"></div>
          <div class="particle p4"></div>
        </a>

        <!-- ARTICLES (milieu — pont entre anime et horreur) -->
        <a href="/articles" class="panel panel--articles">
          <div class="panel-bg"></div>
          <div class="panel-overlay"></div>
          <div class="panel-content">
            <h2>Articles</h2>
            <span class="panel-cta">Explorer &rarr;</span>
          </div>
        </a>

        <!-- HORREUR (droite) -->
        <a href="/films" class="panel panel--horreur">
          <div class="panel-bg"></div>
          <div class="panel-overlay"></div>
          <div class="panel-content">
            <h2>Horreur</h2>
            <span class="panel-cta">Explorer &rarr;</span>
          </div>
          <div class="drip drip-1"></div>
          <div class="drip drip-2"></div>
          <div class="drip drip-3"></div>
        </a>
      </div>
    </div>
  </body>
</html>

<style>
  /* ===== Reset ===== */
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
  html, body { height: 100%; overflow: hidden; }
  body { font-family: 'Segoe UI', system-ui, -apple-system, sans-serif; background: #0a0a0a; }
  a { text-decoration: none; color: inherit; }

  .home { position: relative; width: 100%; height: 100vh; }

  /* Logo */
  .home-logo {
    position: fixed;
    top: 1.2rem;
    left: 50%;
    transform: translateX(-50%);
    font-size: 1.4rem;
    font-weight: 700;
    color: #e8e8e8;
    z-index: 100;
    letter-spacing: -0.02em;
    text-shadow: 0 2px 20px rgba(0,0,0,0.8);
    pointer-events: none;
  }
  .home-logo span { color: #e63946; }

  /* ===== Panels ===== */
  .panels {
    display: flex;
    width: 100%;
    height: 100vh;
  }

  .panel {
    position: relative;
    flex: 1;
    overflow: hidden;
    cursor: pointer;
    transition: flex 0.6s cubic-bezier(0.4, 0, 0.2, 1);
  }

  /* Au survol, le panel actif grandit, les autres rétrécissent */
  .panels:hover .panel { flex: 0.8; }
  .panels:hover .panel:hover { flex: 2; }

  /* Background layer */
  .panel-bg {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    transition: transform 0.6s ease, filter 0.6s ease;
  }
  .panel:hover .panel-bg { transform: scale(1.08); }

  /* Overlay */
  .panel-overlay {
    position: absolute;
    inset: 0;
    transition: all 0.6s ease;
  }

  /* Content — positionné dans le tiers inférieur */
  .panel-content {
    position: absolute;
    bottom: 15%;
    left: 0;
    right: 0;
    padding: 0 2rem;
    z-index: 10;
    text-align: center;
    transition: all 0.5s ease;
  }

  .panel-content h2 {
    font-size: 2rem;
    font-weight: 800;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    text-shadow: 0 2px 20px rgba(0,0,0,0.7);
    transition: all 0.5s ease;
  }
  .panel:hover .panel-content h2 {
    font-size: 2.8rem;
    letter-spacing: 0.1em;
  }

  .panel-cta {
    display: inline-block;
    margin-top: 0.8rem;
    font-size: 0.85rem;
    font-weight: 600;
    opacity: 0;
    transform: translateY(10px);
    transition: all 0.4s ease 0.15s;
    padding: 0.4rem 1rem;
    border-radius: 999px;
    border: 1px solid rgba(255,255,255,0.25);
    backdrop-filter: blur(4px);
  }
  .panel:hover .panel-cta {
    opacity: 1;
    transform: translateY(0);
  }

  /* ============================
     ANIME PANEL
     ============================ */
  .panel--anime .panel-bg {
    background: linear-gradient(135deg, #1a3a6e 0%, #2b60b0 50%, #3a7de0 100%);
  }
  .panel--anime .panel-overlay {
    background: linear-gradient(to top, rgba(20, 50, 110, 0.6) 0%, transparent 45%);
  }
  .panel--anime:hover .panel-overlay {
    background: linear-gradient(to top, rgba(100, 180, 255, 0.25) 0%, rgba(50, 120, 220, 0.1) 35%, transparent 100%);
  }
  .panel--anime .panel-content h2 { color: #b0ddff; }
  .panel--anime:hover .panel-content h2 { color: #d4eeff; text-shadow: 0 0 50px rgba(120, 200, 255, 0.8); }
  .panel--anime .panel-cta { background: rgba(100, 180, 255, 0.3); }
  .panel--anime:hover .panel-cta { background: rgba(100, 180, 255, 0.5); border-color: #80c8ff; }
  .panel--anime .panel-content { color: #d8edff; }

  /* Particules flottantes (étoiles/étincelles anime) */
  .particle {
    position: absolute;
    border-radius: 50%;
    background: rgba(100, 180, 255, 0.5);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.6s;
  }
  .panel--anime:hover .particle { opacity: 1; }

  .p1 { width: 6px; height: 6px; top: 20%; left: 30%; animation: float 4s ease-in-out infinite; }
  .p2 { width: 4px; height: 4px; top: 40%; left: 60%; animation: float 3s ease-in-out 0.5s infinite; background: rgba(180, 220, 255, 0.6); }
  .p3 { width: 8px; height: 8px; top: 60%; left: 25%; animation: float 5s ease-in-out 1s infinite; background: rgba(100, 180, 255, 0.35); }
  .p4 { width: 3px; height: 3px; top: 30%; left: 70%; animation: float 3.5s ease-in-out 0.8s infinite; background: rgba(180, 220, 255, 0.5); }

  @keyframes float {
    0%, 100% { transform: translateY(0) scale(1); }
    50% { transform: translateY(-20px) scale(1.3); }
  }

  /* ============================
     HORREUR PANEL
     ============================ */
  .panel--horreur .panel-bg {
    background: linear-gradient(135deg, #1a0000 0%, #2d0a0a 50%, #0d0d0d 100%);
  }
  .panel--horreur .panel-overlay {
    background: linear-gradient(to top, rgba(20, 0, 0, 0.9) 0%, transparent 60%);
  }
  .panel--horreur:hover .panel-overlay {
    background: linear-gradient(to top, rgba(230, 57, 70, 0.3) 0%, rgba(40, 0, 0, 0.5) 50%, rgba(0, 0, 0, 0.2) 100%);
    box-shadow: inset 0 0 120px rgba(230, 57, 70, 0.15);
  }
  .panel--horreur .panel-content h2 { color: #ff6b6b; }
  .panel--horreur:hover .panel-content h2 {
    color: #ff4444;
    text-shadow: 0 0 40px rgba(230, 57, 70, 0.8);
    animation: flicker 3s infinite;
  }
  .panel--horreur .panel-cta { background: rgba(230, 57, 70, 0.15); }
  .panel--horreur:hover .panel-cta { background: rgba(230, 57, 70, 0.3); border-color: #e63946; }
  .panel--horreur .panel-content { color: #ffaaaa; }

  /* Effet tremblement subtil du titre horreur */
  @keyframes flicker {
    0%, 95%, 100% { opacity: 1; }
    96% { opacity: 0.8; }
    97% { opacity: 1; }
    98% { opacity: 0.6; }
    99% { opacity: 1; }
  }

  /* Gouttes de sang */
  .drip {
    position: absolute;
    top: 0;
    width: 3px;
    background: linear-gradient(to bottom, transparent, #8b0000, #e63946);
    border-radius: 0 0 50% 50%;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s;
  }
  .panel--horreur:hover .drip { opacity: 0.7; }

  .drip-1 { left: 25%; height: 0; animation: dripping 4s ease-in 0.5s infinite; }
  .drip-2 { left: 55%; height: 0; animation: dripping 5s ease-in 1.5s infinite; }
  .drip-3 { left: 75%; height: 0; animation: dripping 4.5s ease-in 2.5s infinite; }

  @keyframes dripping {
    0% { height: 0; opacity: 0; }
    10% { opacity: 0.7; }
    60% { height: 80px; opacity: 0.7; }
    100% { height: 80px; opacity: 0; transform: translateY(40px); }
  }

  /* ============================
     ARTICLES PANEL
     ============================ */
  .panel--articles .panel-bg {
    background: linear-gradient(135deg, #1a150d 0%, #2a2014 50%, #332a1a 100%);
  }
  .panel--articles .panel-overlay {
    background: linear-gradient(to top, rgba(20, 15, 5, 0.85) 0%, transparent 60%);
  }
  .panel--articles:hover .panel-overlay {
    background: linear-gradient(to top, rgba(222, 196, 148, 0.2) 0%, rgba(20, 15, 5, 0.25) 50%, transparent 100%);
  }
  .panel--articles .panel-content h2 { color: #dec494; }
  .panel--articles:hover .panel-content h2 { color: #f0ddb8; text-shadow: 0 0 30px rgba(222, 196, 148, 0.5); }
  .panel--articles .panel-cta { background: rgba(222, 196, 148, 0.15); }
  .panel--articles:hover .panel-cta { background: rgba(222, 196, 148, 0.3); border-color: #dec494; }
  .panel--articles .panel-content { color: #e8d8b8; }

  /* Lignes horizontales style "page de livre" */
  .panel--articles::before {
    content: '';
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(
      0deg,
      transparent,
      transparent 38px,
      rgba(200, 170, 110, 0.03) 38px,
      rgba(200, 170, 110, 0.03) 39px
    );
    opacity: 0;
    transition: opacity 0.6s;
    pointer-events: none;
    z-index: 5;
  }
  .panel--articles:hover::before { opacity: 1; }

  /* ===== Mobile ===== */
  @media (max-width: 768px) {
    .panels { flex-direction: column; }
    .panel { flex: 1 !important; }
    .panels:hover .panel { flex: 1 !important; }
    .panels:hover .panel:hover { flex: 2 !important; }
    .panel-content { opacity: 1; transform: translateY(0); }
    .panel-content p { opacity: 0.7; transform: translateY(0); }
    .panel-cta { opacity: 0.8; transform: translateY(0); }
    .panel-content h2 { font-size: 1.8rem; }
    .home-logo { font-size: 1.1rem; }
  }
</style>
